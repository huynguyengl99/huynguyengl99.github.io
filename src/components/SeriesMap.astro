---
import { getCollection } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { seriesInfo } from "@/data/series";
import config from "@/config";

type Props = {
  series: string;
  /** Slug of the post this is rendered in, marked rather than linked. */
  current?: string;
};

const { series, current } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const { outline = [] } = seriesInfo(series);

// A planned part links only once its post is actually published, so the map
// never points at a page that does not exist yet.
const published = new Map(
  (await getCollection("posts"))
    .filter(postFilter)
    .filter(post => post.data.series === series)
    .map(post => [post.id.split("/").pop(), post])
);

const parts = outline.map(part => {
  const post = published.get(part.slug);
  return {
    ...part,
    // the real title wins once it exists, in case the plan was worded loosely
    title: post ? post.data.title.replace(`${series}, `, "").replace(/^Part \d+: /, "") : part.title,
    href: post ? getPostUrl(post.id, post.filePath, locale) : undefined,
    isCurrent: part.slug === current,
  };
});
---

<ol start="0">
  {
    parts.map(part => (
      <li>
        {part.isCurrent ? (
          <span>{part.title} (this post)</span>
        ) : part.href ? (
          <a
            href={part.href}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            {part.title}
          </a>
        ) : (
          <span class="text-muted-foreground">{part.title}</span>
        )}
      </li>
    ))
  }
</ol>
