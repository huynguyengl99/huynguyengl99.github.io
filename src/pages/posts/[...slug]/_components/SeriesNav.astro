---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSeriesParts, shortPartTitle } from "@/utils/getSeries";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

type Props = {
  series: string;
  currentId: string;
};

const { series, currentId } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const parts = getSeriesParts(await getCollection("posts"), series);
const index = parts.findIndex(post => post.id === currentId);
const previous = index > 0 ? parts[index - 1] : undefined;
const next =
  index >= 0 && index < parts.length - 1 ? parts[index + 1] : undefined;
const seriesUrl = getRelativeLocaleUrl(locale, `series/${slugifyStr(series)}`);
---

{
  parts.length > 1 && (
    <aside
      data-pagefind-ignore
      class="border-border bg-muted/40 my-8 rounded-lg border p-4"
    >
      <p class="text-sm">
        <span class="font-semibold">{t.post.seriesLabel}:</span>{" "}
        <a
          href={seriesUrl}
          class="text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          {series}
        </a>
        <span class="text-muted-foreground">
          {" "}
          · {tplStr(t.post.seriesProgress, { total: parts.length })}
        </span>
      </p>

      {(previous || next) && (
        <div class="mt-2 space-y-1 text-sm">
          {previous && (
            <p>
              <span class="text-muted-foreground">
                {t.post.seriesPrevious}:
              </span>{" "}
              <a
                href={getPostUrl(previous.id, previous.filePath, locale)}
                class="text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                {shortPartTitle(previous.data.title, series)}
              </a>
            </p>
          )}
          {next && (
            <p>
              <span class="text-muted-foreground">{t.post.seriesNext}:</span>{" "}
              <a
                href={getPostUrl(next.id, next.filePath, locale)}
                class="text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                {shortPartTitle(next.data.title, series)}
              </a>
            </p>
          )}
        </div>
      )}

      {/* The full list is useful but long, so it stays one click away rather
          than pushing the post down the page. */}
      <details class="mt-3">
        <summary class="text-muted-foreground cursor-pointer text-sm">
          {tplStr(t.post.seriesAllParts, { total: parts.length })}
        </summary>
        <ol class="mt-2 space-y-1.5 text-sm">
          {parts.map(post =>
            post.id === currentId ? (
              <li class="text-accent font-medium">
                {shortPartTitle(post.data.title, series)}
              </li>
            ) : (
              <li>
                <a
                  href={getPostUrl(post.id, post.filePath, locale)}
                  class="hover:text-accent underline decoration-dashed underline-offset-4"
                >
                  {shortPartTitle(post.data.title, series)}
                </a>
              </li>
            )
          )}
        </ol>
      </details>
    </aside>
  )
}
