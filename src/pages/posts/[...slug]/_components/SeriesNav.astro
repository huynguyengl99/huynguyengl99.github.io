---
import { getCollection } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

type Props = {
  series: string;
  currentId: string;
};

const { series, currentId } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const parts = (await getCollection("posts"))
  .filter(post => post.data.series === series && !post.data.draft)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

// Titles read "Agent Graph Engineering, Part 2: ...". Inside a box that already
// names the series, only the "Part 2: ..." half is worth showing.
const shortTitle = (title: string) =>
  title.startsWith(`${series}, `) ? title.slice(series.length + 2) : title;
---

{
  parts.length > 1 && (
    <aside
      data-pagefind-ignore
      class="border-border bg-muted/40 my-8 rounded-lg border p-4"
    >
      <p class="text-sm font-semibold">
        {t.post.seriesLabel}: <span class="text-accent">{series}</span>
      </p>
      <p class="text-muted-foreground mt-0.5 text-xs">
        {tplStr(t.post.seriesProgress, { total: parts.length })}
      </p>
      <ol class="mt-3 space-y-1.5 text-sm">
        {parts.map(post =>
          post.id === currentId ? (
            <li class="text-accent font-medium">
              {shortTitle(post.data.title)}
            </li>
          ) : (
            <li>
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class="hover:text-accent underline decoration-dashed underline-offset-4"
              >
                {shortTitle(post.data.title)}
              </a>
            </li>
          )
        )}
      </ol>
    </aside>
  )
}
